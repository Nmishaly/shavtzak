rules_version = '2';
// הגנה על הנתונים: רק מי שהמנהל אישר יכול לקרוא; רק "עריכה" יכול לכתוב.
// להחליף את OWNER_EMAIL_HERE בכתובת הג'ימייל של המנהל (באותיות קטנות), כמו ב-firebase-config.js.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'OWNER_EMAIL_HERE';
    }
    function myRole() {
      let p = /databases/$(database)/documents/access/$(request.auth.uid);
      return exists(p) ? get(p).data.role : 'none';
    }
    function canRead() { return isOwner() || (signedIn() && myRole() in ['viewer', 'editor']); }
    function canWrite() { return isOwner() || (signedIn() && myRole() == 'editor'); }

    // בקשות גישה: כל משתמש מחובר יכול ליצור בקשה "ממתינה" לעצמו בלבד; רק המנהל משנה תפקיד.
    match /access/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'requestedAt'])
        && request.resource.data.role == 'pending'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.requestedAt == request.time;
      allow update, delete: if isOwner();
    }

    // שמות תצוגה ("עודכן על ידי ...")
    match /profiles/{uid} {
      allow read: if canRead();
      allow write: if canRead() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name']) && request.resource.data.name is string
        && request.resource.data.name.size() < 120;
    }

    // נתוני השיבוץ
    match /plan/{docId} { allow read: if canRead(); allow write: if canWrite(); }
    match /weeks/{weekId} { allow read: if canRead(); allow write: if canWrite(); }
  }
}
